OPENAI_API_KEY=your_openai_or_openrouter_api_key
# Optional: set to OpenRouter for testing with openai/gpt-4o etc.
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=gpt-4o-mini
# OPENROUTER_SITE_URL=http://localhost:5173
# OPENROUTER_SITE_NAME=QuoteGen

# Supabase browser client — used only for login (Supabase Auth).
# The anon/publishable key is designed to be public and is the ONLY Supabase key
# allowed in VITE_* vars, because everything under VITE_ ends up in the bundle.
# Copy it from Supabase -> Project Settings -> API Keys -> anon public.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key

# For the confirmation email links to work, set in the Supabase dashboard under
# Authentication -> URL Configuration:
#   Site URL      = http://localhost:5173
#   Redirect URLs = http://localhost:5173/**
# (The default Site URL is port 3000, which this app does not use.)

# Supabase (server-only; do NOT put the service role key in Vite/frontend env)
# Create a project at https://supabase.com, then run migrations in order in the SQL editor:
#   supabase/migrations/20260811160000_persistence_foundation.sql
#   supabase/migrations/20260811170000_knowledge_autofill.sql
# (or via Supabase CLI).
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Optional: emails that may claim older shared Word/Excel layouts (pre user-scoping).
# UPLOAD_TEMPLATE_LEGACY_OWNER_EMAILS=infodigteq@gmail.com
# Open editor — OnlyOffice Document Server (Word/Excel as-is editing).
# Local Mac (Docker Desktop):
#   docker compose -f docker-compose.onlyoffice.yml up -d
# ONLYOFFICE_URL=http://localhost:8080
# PUBLIC_API_URL=http://host.docker.internal:3001
# OFFICE_FILE_SECRET=change-me-to-a-long-random-string
# ONLYOFFICE_JWT_SECRET=dev-onlyoffice-secret
# Must match JWT_SECRET in docker-compose.onlyoffice.yml
#
# Live site: run OnlyOffice as its own service, then set on the QuoteGen API host:
# ONLYOFFICE_URL=https://office.quotegen.ai
# PUBLIC_API_URL=https://www.quotegen.ai
# (PUBLIC_API_URL must be reachable FROM the OnlyOffice container/server — not localhost.)
# ONLYOFFICE_JWT_SECRET=<same as JWT_SECRET in docker-compose>
# OFFICE_FILE_SECRET=<long random string>
#
# Supabase Auth → URL Configuration for production:
#   Site URL      = https://www.quotegen.ai
#   Redirect URLs = https://www.quotegen.ai/**
