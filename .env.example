OPENAI_API_KEY=your_openai_or_openrouter_api_key
# Optional: set to OpenRouter for testing with openai/gpt-4o etc.
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=gpt-4o-mini
# OPENROUTER_SITE_URL=http://localhost:5173
# OPENROUTER_SITE_NAME=QuoteGen

# Supabase browser client — used only for login (Supabase Auth).
# The anon/publishable key is designed to be public and is the ONLY Supabase key
# allowed in VITE_* vars, because everything under VITE_ ends up in the bundle.
# Copy it from Supabase -> Project Settings -> API Keys -> anon public.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key

# For the confirmation email links to work, set in the Supabase dashboard under
# Authentication -> URL Configuration:
#   Site URL      = http://localhost:5173
#   Redirect URLs = http://localhost:5173/**
# (The default Site URL is port 3000, which this app does not use.)

# Supabase (server-only; do NOT put the service role key in Vite/frontend env)
# Create a project at https://supabase.com, then run migrations in order in the SQL editor:
#   supabase/migrations/20260811160000_persistence_foundation.sql
#   supabase/migrations/20260811170000_knowledge_autofill.sql
# (or via Supabase CLI).
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
